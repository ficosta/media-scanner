{
  "extends": "@sofie-automation/code-standard-preset/ts/tsconfig.lib",
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules/**"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "*": [
        "./node_modules/*"
      ],
      "@helper/media-scanner": [
        "./src/main.ts"
      ]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2024"
    ],
    "skipLibCheck": true
  }
}
